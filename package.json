{
  "name": "complyos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:generate": "npm run generate -w @complyos/database",
    "db:migrate": "npx prisma migrate dev --schema packages/database/schema.prisma",
    "db:push": "npx prisma db push --schema packages/database/schema.prisma",
    "db:seed": "npm run seed -w @complyos/database",
    "db:studio": "npx prisma studio --schema packages/database/schema.prisma",
    "db:validate": "npx prisma validate --schema packages/database/schema.prisma",
    "build:services": "npm run build -w @complyos/ca-service",
    "build:all": "npm run build --workspaces --if-present",
    "dev:seed": "DATABASE_URL=postgresql://complyos:complyos_dev_password@localhost:5432/complyos npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
