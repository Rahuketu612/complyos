{
  "name": "@complyos/auth-service",
  "version": "1.0.0",
  "description": "COMPLYOS Authentication Service",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "seed:dev": "ts-node src/seed.ts",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:generate": "prisma generate --schema ../../packages/database/schema.prisma",
    "postinstall": "prisma generate --schema ../../packages/database/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "express": "^4.22.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@prisma/client": "5.22.0",
    "@prisma/engines": "5.22.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.8",
    "prisma": "5.22.0",
    "typescript": "^5.9.3"
  }
}
