# Environment Variables
# Copy to .env and fill in values

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://complyos:complyos_dev_password@localhost:5432/complyos

# JWT
JWT_SECRET=complyos-jwt-secret-dev-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=complyos-refresh-secret-dev-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001