# Environment Variables
NODE_ENV=development
PORT=3003
DATABASE_URL=postgresql://complyos:complyos_dev_password@localhost:5432/complyos

# JWT Secret (required - validated at startup)
JWT_SECRET=your-secret-key-at-least-32-characters-long

# GST API (optional)
GST_API_URL=https://api.gst.gov.in
GST_API_USERNAME=your-gst-username
GST_API_PASSWORD=your-gst-password

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003
